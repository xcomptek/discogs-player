{
  "manifest_version": 3,
  "name": "Discogs Player",
  "version": "0.1.0",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Discogs Player",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "description": "Developed by @dakou_cd",
  "permissions": ["webRequest"],
  "host_permissions": [
    "https://*.youtube.com/*",
    "https://*.youtube-nocookie.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.discogs.com/release/*",
        "https://discogs.com/release/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.youtube-nocookie.com/embed/*"],
      "js": ["youtube-frame.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
